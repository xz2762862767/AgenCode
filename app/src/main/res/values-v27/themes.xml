<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8.1（API 27）起才认识 windowLightNavigationBar。
  放在这里而不是 values/themes.xml：后者会让 Android 8.0 拿到一个它不认识的属性，
  静默失效，浅色主题下就成了白底白图标的导航栏。
-->
<resources>
    <style name="AppTheme.Light" parent="AppTheme.Light.Base">
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
