<?xml version="1.0" encoding="utf-8"?>
<!--
  对话框背景：覆盖 Theme.AppCompat.Dialog 默认的
  @android:drawable/dialog_background_material（其 solid 写死
  @color/background_material_light，浅灰白，不随主题变化，
  导致深色/黑色主题下所有 AlertDialog 都是白底）。

  注意：这里不能再套 layer-list + item inset。
  inset 只缩小背景的「绘制」区域，不参与布局——内容仍然从窗口边缘开始排，
  结果是背景框比内容小 16dp，标题看起来压在背景外沿上，顶部显得很挤。
  改为纯 shape 铺满窗口，缩进统一交给各面板自己的 padding 控制。

  颜色用 ?attr/neb_surface，跟随当前对话框主题解析：
  深色 #161B24 / 黑色 #0A0A0D / 浅色 #FFFFFF。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/neb_surface" />
</shape>
