<?xml version="1.0" encoding="utf-8"?>
<!-- 顶栏设置入口：芯片造型（模型/算力 + 参数设置的双重语义），替代原来的通用齿轮。
     几何在 24px 下逐像素校验过：只用「外框 + 8 引脚 + 中心圆盘」，
     不加内部连线——那会在小尺寸下与圆心粘连成一坨。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">

    <!-- 芯片外框 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M7.7,4.5 L16.3,4.5 A3.2,3.2 0 0 1 19.5,7.7 L19.5,16.3 A3.2,3.2 0 0 1 16.3,19.5 L7.7,19.5 A3.2,3.2 0 0 1 4.5,16.3 L4.5,7.7 A3.2,3.2 0 0 1 7.7,4.5 Z" />

    <!-- 顶部 / 底部引脚 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M9.2,1.7 L9.2,4.5 M14.8,1.7 L14.8,4.5 M9.2,19.5 L9.2,22.3 M14.8,19.5 L14.8,22.3" />

    <!-- 左侧 / 右侧引脚 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M1.7,9.2 L4.5,9.2 M1.7,14.8 L4.5,14.8 M19.5,9.2 L22.3,9.2 M19.5,14.8 L22.3,14.8" />

    <!-- 中心圆盘：视觉重心，也是"模型核心"那一笔 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.7,12 A3.3,3.3 0 1 1 15.3,12 A3.3,3.3 0 1 1 8.7,12 Z" />
</vector>
