<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 长任务保活：回答/执行命令期间用前台服务，避免退到后台被系统回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 让正文里的产物卡片可以直接安装 APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 设置页「电池优化」一键跳系统白名单弹窗 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 把生成的 APK 写进公共「下载」目录；targetSdk 34 下没有这条就只能靠 MediaStore -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Android 11+ 需要「所有文件访问」才能用 File API 直接读写公共下载目录 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 11+ 包可见性：不声明则无法绑定系统 TTS 引擎，朗读会静默失败 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".NebulaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nebula.aichat.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="关于"
            android:parentActivityName=".SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".DiagActivity"
            android:exported="false"
            android:label="运行诊断"
            android:parentActivityName=".SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 内置浏览器：configChanges 带上 keyboard 是为了转屏/弹键盘时不重建 WebView，
             重建会丢页面状态（滚动位置、已翻译的 DOM），体验上像刷新了一次 -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:label="浏览器"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:hardwareAccelerated="true" />



        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
